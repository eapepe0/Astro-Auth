---
import Navbar from '@/components/shared/Navbar.astro';

interface Props {
    title? : string;
}   


const {title = 'Astro Auth Page' } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator}>
    <title>{title}</title>
</head>
<body>
   <Navbar/>
   <main class="container m-auto max-w-3xl px-5">
        <slot/>
    </main>
</body>
</html>