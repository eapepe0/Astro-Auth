---
import { firebase } from "@/firebase";
import AuthLayout from "@/layouts/AuthLayout.astro";

// cargamos las cookies
const email = Astro.cookies.get("email")?.value ?? ""; // si existe el cookie o sera un string vacio
const remember_me = !!email; // hacemos doble negacion para transformar a booleano

// tomamos los datos del usuario
const firebaseUser = firebase.auth.currentUser;

// si tenemos datos vamos a la pantalla de /
if (firebaseUser) {
  return Astro.redirect("/");
}
---

<AuthLayout>
  <div class="flex justify-center self-center z-10">
    <div class="p-12 bg-white mx-auto rounded-2xl w-100">
      <div class="mb-4">
        <h3 class="font-semibold text-2xl text-gray-800">Login</h3>
        <p class="text-gray-500">Please login to your account.</p>
      </div>
      <form class="space-y-5">
        <div class="space-y-2">
          <label class="text-sm font-medium text-gray-700 tracking-wide"
            >Email</label
          >
          <input
            class="w-full text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
            type="email"
            placeholder="mail@gmail.com"
            name="email"
            value={email}
          />
        </div>
        <div class="space-y-2">
          <label class="mb-5 text-sm font-medium text-gray-700 tracking-wide">
            Password
          </label>
          <input
            class="w-full content-center text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
            type="password"
            placeholder="Enter your password"
            name="password"
          />
        </div>
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <input
              id="remember_me"
              name="remember_me"
              type="checkbox"
              class="h-4 w-4 bg-blue-500 focus:ring-blue-400 border-gray-300 rounded"
              checked={remember_me}
            />
            <label for="remember_me" class="ml-2 block text-sm text-gray-800">
              Recuerdame
            </label>
          </div>
          <div class="text-sm">
            <a href="/register" class="text-green-400 hover:text-green-500">
              ¿No tienes una cuenta?
            </a>
          </div>
        </div>
        <div>
          <button
            type="submit"
            class="disabled:bg-gray-300 w-full flex justify-center bg-green-400 hover:bg-green-500 text-gray-100 p-3 rounded-full tracking-wide font-semibold shadow-lg cursor-pointer transition ease-in duration-500"
            id="btn-signIn"
          >
            Ingresar
          </button>
          <div class="flex flex-1 w-full my-2">
            <div class="w-full">
              <button
                type="button"
                class="disabled:bg-gray-300 w-full flex justify-center bg-red-400 hover:bg-red-500 text-gray-100 p-3 rounded-full tracking-wide font-semibold shadow-lg cursor-pointer transition ease-in duration-500"
                id="btn-google"
              >
                Ingresar con Google
              </button>
            </div>
          </div>
        </div>
      </form>
      <div class="pt-5 text-center text-gray-400 text-xs">
        <span>
          Copyright © 2021-{new Date().getFullYear()}
          <a
            href="https://codepen.io/uidesignhub"
            rel=""
            target="_blank"
            title="Ajimon"
            class="text-green hover:text-green-500">AJI</a
          ></span
        >
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { firebase } from "@/firebase";
import { actions } from "astro:actions";
  import { GoogleAuthProvider, signInWithPopup } from "firebase/auth";
  import Swal from "sweetalert2";

  const form = document.querySelector("form") as HTMLFormElement;
  const btnSignIn = document.querySelector("#btn-signIn") as HTMLButtonElement;
  const btnGoogle = document.querySelector("#btn-google") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    // deshabilitamos el submit
    e.preventDefault();
    // si lo apretamos lo deshabilitamos para que no se pueda mandar muchos request
    btnSignIn.setAttribute("disabled", "disabled");

    // obtenemos los datos del formulario
    const formData = new FormData(form);

    // extraemos si hay un error en la respuesta
    const { error } = await actions.loginUser(formData);

    // si hay un error mostramos el error
    if (error) {
      Swal.fire({
        icon: "error",
        title: "Credenciales incorrectas",
        text: error.message,
      });
      // habilitamos nuevamente el boton
      btnSignIn?.removeAttribute("disabled");
      return;
    }

    // si no hay ningun error entramos a la ruta root tambien podemos ir directamente a /protected
    window.location.replace("/");
  });

  btnGoogle.addEventListener('click',async () => {
    btnGoogle.setAttribute("disabled", "disabled");
    btnGoogle?.removeAttribute("hover");
    // creamos el proveedor
    const provider = new GoogleAuthProvider();
    // manejo de credenciales
    try {
      // Paso 1 : Obtener las credenciales del lado del cliente.
      // usamos signInWithPopup que devuelve nuestras credenciales si nos logeamos con google
      btnGoogle.classList.remove('hover:bg-red-500');
      const credenciales = await signInWithPopup(firebase.auth , provider);
    
      // Paso 2 : Verificar las credenciales en el backend
      const {error} = await actions.loginWithGoogle(credenciales);

      // si la funcion devuelve un error
      if(error){
        alert(error.message);
        return;
      }

      // cambiamos el texto del boton
      btnGoogle.innerText = 'Redireccionando...!';
      btnGoogle?.removeAttribute("disabled");
      // redireccionamos
      window.location.replace('/');
      // si hay un error en el popup
    } catch (error) {
      console.log(error)
    }

    
  })


</script>
